{
  "name": "ai-qa-engineer",
  "displayName": "AI QA Engineer",
  "description": "Autonomous AI QA engineer: describe a feature, review the generated Playwright + BDD automation, approve, run, self-heal.",
  "version": "0.1.0",
  "publisher": "aiqa",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "AI",
    "Other"
  ],
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "bdd",
    "automation",
    "ai",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiqa",
          "title": "AI QA Engineer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiqa": [
        {
          "id": "aiqa.assistant",
          "name": "Assistant",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "aiqa.approvals",
          "name": "Approvals",
          "icon": "$(check)"
        },
        {
          "id": "aiqa.runs",
          "name": "Test Runs",
          "icon": "$(history)"
        },
        {
          "id": "aiqa.failures",
          "name": "Failures",
          "icon": "$(error)"
        },
        {
          "id": "aiqa.healing",
          "name": "Self-Healing",
          "icon": "$(wrench)"
        },
        {
          "id": "aiqa.activity",
          "name": "Agent Activity",
          "icon": "$(pulse)"
        },
        {
          "id": "aiqa.knowledge",
          "name": "Knowledge",
          "icon": "$(database)"
        },
        {
          "id": "aiqa.standards",
          "name": "Standards",
          "icon": "$(law)"
        },
        {
          "id": "aiqa.costs",
          "name": "Costs",
          "icon": "$(credit-card)"
        },
        {
          "id": "aiqa.agents",
          "name": "Agents",
          "icon": "$(organization)"
        },
        {
          "id": "aiqa.reports",
          "name": "Reports",
          "icon": "$(file-text)"
        },
        {
          "id": "aiqa.configuration",
          "name": "Configuration",
          "icon": "$(gear)"
        }
      ]
    },
    "commands": [
      {
        "command": "aiqa.openChat",
        "title": "AI QA: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aiqa.automate",
        "title": "AI QA: Automate a Feature..."
      },
      {
        "command": "aiqa.planOnly",
        "title": "AI QA: Design Test Plan Only..."
      },
      {
        "command": "aiqa.generateOnly",
        "title": "AI QA: Generate Tests (no execution)..."
      },
      {
        "command": "aiqa.runTests",
        "title": "AI QA: Run Existing Tests"
      },
      {
        "command": "aiqa.healFailures",
        "title": "AI QA: Diagnose and Self-Heal Failures"
      },
      {
        "command": "aiqa.automateFromJira",
        "title": "AI QA: Automate from a Jira Issue..."
      },
      {
        "command": "aiqa.registerProject",
        "title": "AI QA: Register This Workspace as a Project"
      },
      {
        "command": "aiqa.indexRepository",
        "title": "AI QA: Index Repository (learn conventions)"
      },
      {
        "command": "aiqa.lintStandards",
        "title": "AI QA: Check Suite Against QA Standards"
      },
      {
        "command": "aiqa.showApprovals",
        "title": "AI QA: Show Pending Approvals"
      },
      {
        "command": "aiqa.reviewDiff",
        "title": "AI QA: Review Proposed Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "aiqa.approve",
        "title": "AI QA: Approve",
        "icon": "$(check)"
      },
      {
        "command": "aiqa.reject",
        "title": "AI QA: Reject",
        "icon": "$(x)"
      },
      {
        "command": "aiqa.openRun",
        "title": "AI QA: Open Run"
      },
      {
        "command": "aiqa.cancelRun",
        "title": "AI QA: Cancel Run",
        "icon": "$(stop-circle)"
      },
      {
        "command": "aiqa.showReport",
        "title": "AI QA: Show Run Report"
      },
      {
        "command": "aiqa.showTrace",
        "title": "AI QA: Show Agent Trace"
      },
      {
        "command": "aiqa.refresh",
        "title": "AI QA: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "aiqa.openDashboard",
        "title": "AI QA: Open Control Plane Dashboard"
      },
      {
        "command": "aiqa.doctor",
        "title": "AI QA: Check Connection and Providers"
      },
      {
        "command": "aiqa.generateAutomation",
        "title": "AI QA: Generate Automation"
      },
      {
        "command": "aiqa.exploreApplication",
        "title": "AI QA: Explore Application"
      },
      {
        "command": "aiqa.generateGherkin",
        "title": "AI QA: Generate Gherkin"
      },
      {
        "command": "aiqa.generatePageObject",
        "title": "AI QA: Generate Page Object"
      },
      {
        "command": "aiqa.generateSteps",
        "title": "AI QA: Generate Steps"
      },
      {
        "command": "aiqa.analyzeFailure",
        "title": "AI QA: Analyze Failure"
      },
      {
        "command": "aiqa.selfHeal",
        "title": "AI QA: Self Heal"
      },
      {
        "command": "aiqa.validateStandards",
        "title": "AI QA: Validate Standards"
      },
      {
        "command": "aiqa.showCost",
        "title": "AI QA: Show Cost"
      },
      {
        "command": "aiqa.generateReport",
        "title": "AI QA: Generate Report"
      },
      {
        "command": "aiqa.showKnowledge",
        "title": "AI QA: Show Project Knowledge"
      },
      {
        "command": "aiqa.initStandards",
        "title": "AI QA: Initialise .aiqa Standards"
      },
      {
        "command": "aiqa.showPipeline",
        "title": "AI QA: Show Agent Pipeline"
      },
      {
        "command": "aiqa.startServer",
        "title": "Start Control Plane",
        "category": "AI QA"
      },
      {
        "command": "aiqa.stopServer",
        "title": "Stop Control Plane",
        "category": "AI QA"
      },
      {
        "command": "aiqa.restartServer",
        "title": "Restart Control Plane",
        "category": "AI QA"
      },
      {
        "command": "aiqa.showServerLog",
        "title": "Show Control Plane Log",
        "category": "AI QA"
      },
      {
        "command": "aiqa.showCoverage",
        "title": "Show Coverage Gaps",
        "category": "AI QA"
      },
      {
        "command": "aiqa.automateInstruction",
        "title": "Automate This",
        "category": "AI QA"
      },
      {
        "command": "aiqa.showSuiteHealth",
        "title": "Show Suite Health",
        "category": "AI QA"
      },
      {
        "command": "aiqa.exploratoryTest",
        "title": "Run Exploratory Pass",
        "category": "AI QA"
      },
      {
        "command": "aiqa.batchFromEpic",
        "title": "Automate a Jira Epic",
        "category": "AI QA"
      },
      {
        "command": "aiqa.resetApiKey",
        "title": "Reset API Key",
        "category": "AI QA"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiqa.openChat",
          "when": "view == aiqa.assistant",
          "group": "navigation@1"
        },
        {
          "command": "aiqa.refresh",
          "when": "view =~ /aiqa\\./",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "aiqa.reviewDiff",
          "when": "view == aiqa.approvals && viewItem == approval",
          "group": "inline@1"
        },
        {
          "command": "aiqa.approve",
          "when": "view == aiqa.approvals && viewItem == approval",
          "group": "inline@2"
        },
        {
          "command": "aiqa.reject",
          "when": "view == aiqa.approvals && viewItem == approval",
          "group": "inline@3"
        },
        {
          "command": "aiqa.showReport",
          "when": "view == aiqa.runs && viewItem == run",
          "group": "1@1"
        },
        {
          "command": "aiqa.showTrace",
          "when": "view == aiqa.runs && viewItem == run",
          "group": "1@2"
        },
        {
          "command": "aiqa.cancelRun",
          "when": "view == aiqa.runs && viewItem == run",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "aiqa.approve",
          "when": "false"
        },
        {
          "command": "aiqa.reject",
          "when": "false"
        },
        {
          "command": "aiqa.openRun",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "AI QA Engineer",
      "properties": {
        "aiqa.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "URL of the AI QA control plane."
        },
        "aiqa.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "API key for the control plane. Leave blank to be prompted once; the value is then stored in the OS keychain via VS Code SecretStorage rather than in settings."
        },
        "aiqa.projectId": {
          "type": "string",
          "default": "",
          "description": "Project id bound to this workspace. Set automatically by 'Register This Workspace as a Project'."
        },
        "aiqa.defaultMode": {
          "type": "string",
          "enum": [
            "plan_only",
            "generate",
            "full",
            "autonomous"
          ],
          "default": "full",
          "enumDescriptions": [
            "Design the test plan only \u2014 write nothing",
            "Design and generate code \u2014 do not execute",
            "Generate, execute and analyse failures",
            "Also self-heal and re-run automatically"
          ],
          "description": "Default autonomy level for new runs."
        },
        "aiqa.autoApprove": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Skips every human approval gate.** Generated code is written and committed without review. Intended for CI only."
        },
        "aiqa.maxCostUsd": {
          "type": "number",
          "default": 2.0,
          "description": "Hard spend ceiling for a single run, in USD."
        },
        "aiqa.showCostInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the live token/cost counter in the status bar."
        },
        "aiqa.openDiffOnApproval": {
          "type": "boolean",
          "default": true,
          "description": "Open the proposed changes in the diff editor as soon as an approval is requested."
        },
        "aiqa.costWarnThresholdUsd": {
          "type": "number",
          "default": 1.0,
          "description": "Warn in the status bar once a single run passes this spend."
        },
        "aiqa.preferFreeModels": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Route low-risk work to free/local models. Disable only if quality matters more than cost on every call."
        },
        "aiqa.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Start the AI QA control plane automatically when the extension activates. An already-running server is always reused, never replaced."
        },
        "aiqa.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter used to start the control plane. Empty means: use a .venv in the repository root, else the system Python."
        },
        "aiqa.repositoryPath": {
          "type": "string",
          "default": "C:\\Users\\Pavan.Kolla\\Desktop\\QA_AI_Agents",
          "description": "Path to the AI QA Engineer checkout to start the control plane from. Needed when the open workspace is your test repository rather than the platform itself."
        }
      }
    },
    "keybindings": [
      {
        "command": "aiqa.openChat",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "ws": "^8.17.0"
  }
}
