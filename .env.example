# ─────────────────────────────────────────────────────────────
# QAgentic — environment template. Copy to .env and fill.
# NOTE: .env is NEVER read by agents and NEVER sent to an LLM.
# ─────────────────────────────────────────────────────────────

# --- Core ---
AIQA_ENV=development
AIQA_HOST=127.0.0.1
AIQA_PORT=8080
AIQA_LOG_LEVEL=INFO
AIQA_SECRET_KEY=change-me-in-production

# --- Database (SQLite by default; switch to Postgres for prod) ---
AIQA_DATABASE_URL=sqlite:///./aiqa.db
# AIQA_DATABASE_URL=postgresql+psycopg://aiqa:aiqa@localhost:5432/aiqa

# --- Redis (optional: queue / pubsub) ---
# AIQA_REDIS_URL=redis://localhost:6379/0

# --- Bootstrap admin API key (created on first start) ---
AIQA_BOOTSTRAP_API_KEY=aiqa_dev_bootstrap_key_change_me

# --- LLM providers (all optional; platform runs fully offline with `mock`) ---
AIQA_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

OPENROUTER_API_KEY=
# The free tier is rate limited PER KEY, so several keys are several allowances.
# Add OPENROUTER_API_KEY_2 .. _8 and the router rotates when one is exhausted,
# rather than stopping the run. Put the key with the largest daily allowance
# first: an account that has ever bought credit gets 1000 free-model requests a
# day instead of 50 (check with GET https://openrouter.ai/api/v1/auth/key).
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Cost governance ---
AIQA_DAILY_COST_LIMIT_USD=10.0
AIQA_MONTHLY_COST_LIMIT_USD=200.0
AIQA_PER_RUN_COST_LIMIT_USD=2.0
AIQA_MAX_TOKENS_PER_RUN=400000

# --- Notifications ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# --- Jira ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
